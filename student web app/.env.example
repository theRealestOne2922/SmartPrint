# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=

# 64 hex chars. Wraps the per-file key that encrypts confidential documents.
# Must be byte-identical to the pi-print-agent's MASTER_KEY, or the Pi cannot
# decrypt what this server encrypted. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Signs the short-lived kiosk release tokens issued after faculty verification.
# Must match the kiosk server's APP_SECRET.
APP_SECRET=

# Optional: transactional email for teacher password-reset OTPs
BREVO_API_KEY=

# Canonical public URL of this API, e.g. https://api.example.edu
# Used to build download links and to check the filePath a client sends when
# creating a job — the Pi fetches whatever that points at, so it must be one of
# ours. Set it explicitly: nginx forwards the client's Host header, so deriving
# the URL from the request lets a caller choose it.
PUBLIC_BASE_URL=

# Comma-separated addresses allowed to reach the admin pages. A trailing dot is
# a prefix match, e.g. 10.0.0.5,192.168.1.
# Leave empty to allow any address (and see a warning at boot).
ADMIN_IP_ALLOWLIST=

# Refuse new uploads once the uploads directory reaches this size, in bytes.
# Defaults to 5GB.
MAX_UPLOAD_STORAGE_BYTES=

# Server port (defaults to 5000)
PORT=5000

# Interface to listen on. Defaults to 127.0.0.1, which is what you want behind
# nginx — the app was once reachable directly on the public interface, which
# skipped every rate limit nginx applies. Only change this if nothing fronts it.
BIND_HOST=127.0.0.1

# Read once, on first boot, and only when no admin exists yet. If either is
# blank a random password is generated and printed to the log a single time.
# Changing these later does nothing; use scripts/set-admin-password.mjs.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Build-time, for the browser bundle (not the server) ---------------------
# Where the frontend sends API calls. Leave blank for local development so the
# pages talk to this same Express server. In production it is the public API
# origin, and it must also appear in firebase.json's connect-src, or the
# Content-Security-Policy will block the request.
VITE_API_BASE=

# Comma-separated domains allowed to REGISTER a new staff account.
# Subdomains count, so chennai.vit.ac.in matches vit.ac.in.
# Applied at registration only — sign-in is unrestricted, or every account
# created before this rule would be locked out.
# Defaults to vit.ac.in. Leave empty to allow any domain.
ALLOWED_SIGNUP_DOMAINS=vit.ac.in
