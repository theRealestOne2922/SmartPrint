# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.test
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.vuepress/.temp
.vuepress/.cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Mac OS
.DS_Store

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo

# Project specific
dist-client/
dist-server/
dist/
build/

# Backup archives (may contain .env files — never commit these)
*.zip

# Uploaded documents — real exam papers and student files pass through here.
# One of them was committed once already, which on a public repo means it was
# published. The server recreates this directory on startup, so nothing needs
# it to be in the repo.
student web app/uploads/
uploads/

# Temp module the Pi agent's test harness writes next to index.js
pi-print-agent/.test-harness-*.mjs

# Generated code graph — regenerate with `graphify extract . --code-only`.
# Committing it would put a 1.4MB machine-written JSON in everyone's diffs and
# conflict on almost every merge.
graphify-out/

# Firebase deploy cache — a filename/mtime/hash manifest the CLI rewrites on
# every deploy. Tracking it means a conflict whenever two people deploy.
**/.firebase/

# Throwaway verification scripts run against a live server.
**/.fulltest.mjs
**/.*-test.mjs
**/.*-check.mjs

# The expected deployment fingerprint is per-install, not per-repo.
# See SECURITY.md, "Working on the right Pi".
pi-print-agent/.deployment-expect
