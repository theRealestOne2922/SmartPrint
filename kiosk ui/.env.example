# MongoDB connection string — same database as the student web app
MONGODB_URI=

# Must match the student web app's APP_SECRET, otherwise release tokens
# issued by one server are rejected by the other.
APP_SECRET=

PORT=5001

# --- Build-time, for the browser bundle (not the server) ---------------------
# Where the kiosk screen sends API calls. Leave blank for local development.
# In production the kiosk is served from the same Firebase site under
# /kiosk-app, so this points at the same public API origin as the web app.
VITE_API_BASE=
