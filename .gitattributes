# Shell scripts must always check out with LF, on every machine.
# install-pi-agent.sh runs on a Raspberry Pi: with CRLF endings bash reads the
# carriage return as part of each command and the whole script fails with
# "$'\r': command not found". Windows contributors have core.autocrlf=true, so
# without this the ending depends on whose laptop last touched the file.
*.sh text eol=lf

# Same reasoning for the agent files the installer embeds, so the embedded copy
# and the source stay byte-identical regardless of checkout settings.
pi-print-agent/*.js text eol=lf
pi-print-agent/models/*.js text eol=lf
